# URL of the TeleForge Express API (see ../backend). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional — enables the "Continue with Google" button.
# Must be the same OAuth client ID as GOOGLE_CLIENT_ID in the backend .env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional — the public URL of this site, used to build absolute link-preview image URLs.
# NEXT_PUBLIC_SITE_URL=https://teleforge.example.com
